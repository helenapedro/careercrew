# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Optional: point the agents at a different OpenAI-compatible endpoint/model.
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-6-luna

# Optional: mock-interview audio models (speech-to-text / text-to-speech).
# CAREERCREW_STT_MODEL=whisper-1
# CAREERCREW_TTS_MODEL=tts-1
# CAREERCREW_TTS_VOICE=alloy

# Optional: default number of mock-interview questions.
# CAREERCREW_INTERVIEW_QUESTIONS=5

# Folder the crew reads resumes and job descriptions from (created automatically).
CAREERCREW_UPLOAD_DIR=uploads

# SQLite database for review history / interviews / chats.
CAREERCREW_DB_PATH=careercrew.db

# Bounded revision limit for the HITL review loop.
# CAREERCREW_MAX_REVISIONS=2
