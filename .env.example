# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Optional: point the agents at a different OpenAI-compatible endpoint/model.
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Folder the crew reads resumes from (created automatically).
CAREERCREW_UPLOAD_DIR=uploads

# SQLite database for the session tracker / review history.
CAREERCREW_DB_PATH=careercrew.db

# Bounded revision limit for the HITL review loop.
# CAREERCREW_MAX_REVISIONS=2
